static const int kGameBindCount = (int)(sizeof(kGameBinds) / sizeof(kGameBinds[0]));

static const BindEntry* FindBindEntry(int aValue)
{
	for (int i = 0; i < kGameBindCount; i++)
	{
		if (kGameBinds[i].Value == aValue) { return &kGameBinds[i]; }
	}
	return nullptr;
}

static const char* BindDisplay(const BindEntry* aEntry)
{
	if (aEntry == nullptr) { return "(未知动作)"; }
	return (aEntry->Chinese != nullptr) ? aEntry->Chinese : aEntry->Name;
}
